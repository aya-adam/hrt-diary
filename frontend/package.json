    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,css}\""
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@apollo/client-integration-react-router": "^0.14.5-alpha.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "graphql": "^16.14.2",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "rxjs": "^7.8.2",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
